{
  "name": "@sneze/x-attributes",
  "version": "0.4.0",
  "description": "Minimal htmx-style x-* attribute library",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "rm -rf dist && tsdown",
    "typecheck": "tsc -b",
    "test": "bun test $(find src -name \"*.ts\" ! -name \"*.d.ts\" ! -name \"iife.ts\" -printf \"./%p \")",
    "prepare": "bun run build"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/bun": "^1.4.4",
    "tsdown": "^0.23.2",
    "typescript": "^7"
  }
}